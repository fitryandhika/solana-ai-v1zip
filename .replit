modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[userenv]

[userenv.shared]
DEMO_MODE = "false"
DEXSCREENER_API_BASE_URL = "https://api.dexscreener.com"
MARKET_POLL_INTERVAL_MS = "10000"
SCANNER_RECONNECT_DELAY_MS = "5000"
SOLANA_RPC_URL = "https://api.mainnet-beta.solana.com"
SOLANA_WS_URL = "wss://api.mainnet-beta.solana.com"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --hostname 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
