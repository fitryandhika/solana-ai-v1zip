# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous/public key, safe to expose to the browser (RLS should protect data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used by API routes and the scanner worker to write data.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# HTTP RPC endpoint (used for occasional lookups).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# WebSocket RPC endpoint (used by the scanner for realtime log/account subscriptions).
# If you only set SOLANA_RPC_URL, the scanner will attempt to derive a wss:// URL
# from it automatically, but a dedicated provider WS URL is strongly recommended.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# NOTE: the public Solana RPC endpoint above is free, shared infrastructure.
# It is rate-limited and not guaranteed to stay connected. For anything beyond
# light development, use a provider (Helius, QuickNode, Triton, etc.) that
# gives you a dedicated RPC + WS URL.

# ---------------------------------------------------------------------------
# DexScreener
# ---------------------------------------------------------------------------
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com

# ---------------------------------------------------------------------------
# Scanner / polling configuration
# ---------------------------------------------------------------------------
# How often (ms) the market-data poller refreshes a given token's snapshot.
MARKET_POLL_INTERVAL_MS=10000

# Base delay (ms) before the scanner attempts to reconnect a dropped WebSocket.
# Actual delay grows with exponential backoff, capped internally.
SCANNER_RECONNECT_DELAY_MS=5000

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# When true, the app is allowed to show clearly-labeled fixture data.
# Production MUST be false. Never use Math.random() for market values
# regardless of this flag.
DEMO_MODE=false
